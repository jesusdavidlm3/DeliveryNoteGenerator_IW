<Window x:Class="DeliveryNoteGenerator.modals.login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:DeliveryNoteGenerator.modals"
        mc:Ignorable="d"
        Title="login" Height="250" Width="400" ResizeMode="NoResize">
    <StackPanel HorizontalAlignment="Center" >
        <TextBlock
            TextAlignment="Center"
            Text="Delivery Note Generator"
            FontSize="25"
            Margin="0 010 0 25"/>
        <Label>Token: </Label>
        <TextBox
            Width="250"
            Padding="3"
            Name="TokenField"/>
        <Button
            Width="50"
            Margin="0 65 0 0"
            Click="SetToken">Login</Button>
    </StackPanel>
</Window>
