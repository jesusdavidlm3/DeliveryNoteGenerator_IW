<Window x:Class="DeliveryNoteGenerator.modals.ItemSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:DeliveryNoteGenerator.modals"
        mc:Ignorable="d"
        Title="ItemSelector" Height="250" Width="400">
    <StackPanel HorizontalAlignment="Center" >
        <TextBlock
            Text="Select Item"
            FontSize="25"
            Margin="0 0 0 10"/>
        <Label Margin="0">Item:</Label>
        <ComboBox
            Padding="3"
            Margin="0 0 0 5"
            IsEditable="True"
            x:Name="ItemSelecto"
            IsTextSearchEnabled="False"
            StaysOpenOnEdit="True"
            DisplayMemberPath="name"
            ItemsSource="{Binding FilteredAssetsList, UpdateSourceTrigger=PropertyChanged}"
            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
        <Label>Quantity:</Label>
        <TextBox/>
        <Button
            Width="50"
            Margin="0 25 0 0">Add</Button>
    </StackPanel>
</Window>
