<Window x:Class="DeliveryNoteGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeliveryNoteGenerator"
        xmlns:viewmodels="clr-namespace:DeliveryNoteGenerator.ViewModels"
        xmlns:collections="clr-namespace:System.Collections;assembly=System.Runtime"
        mc:Ignorable="d"
        Title="Interactive Workers delivery note generator" Height="600" Width="900" ResizeMode="NoResize">
    
    <Window.Resources>
        <viewmodels:MainWindowViewModel x:Key="ViewModel"/>
    </Window.Resources>
        
    <StackPanel HorizontalAlignment="Center">
        <TextBlock Text="Delivery note Generator" FontSize="40" Margin="0 0 0 30" TextAlignment="Center"/>
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            
            <Label Grid.Row="0">Responsible:</Label>
            <ComboBox
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                x:Name="ResponsibleSelector"
                IsEditable="True"
                IsTextSearchEnabled="False"
                StaysOpenOnEdit="True"
                ItemsSource="{Binding Source={StaticResource ViewModel}, Path=FilteredUsersList, Mode=TwoWay}"
                DisplayMemberPath="name"
                Text="{Binding Source={StaticResource ViewModel}, Path=SearchText, Mode=TwoWay}"
                SelectedItem="{Binding Source={StaticResource ViewModel}, Path=SelectedUser, Mode=OneWayToSource}"/>
            
            <Label Grid.Row="0" Grid.Column="3">Date: </Label>
            <DatePicker Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2"></DatePicker>
        </Grid>
        
        <DataGrid 
            Margin="0 10 0 0"
            CanUserResizeColumns="False"
            Width="550"
            Height="230"
            AutoGenerateColumns="False"
            ItemsSource="{Binding Source={StaticResource ViewModel}, Path=SelectedAssets, Mode=TwoWay}"
            VerticalScrollBarVisibility="Visible">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Asset Tag" Width="110" Binding="{Binding asset_tag}"/>
                <DataGridTextColumn Header="Name" Width="230" Binding="{Binding name}"/>
                <DataGridTextColumn Header="Quantity" Width="70" Binding="{Binding Quantity}"/>
                <DataGridTemplateColumn Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                Content="Delete"
                                Command="{Binding Source={StaticResource ViewModel}, Path=DeleteItem}"
                                CommandParameter="{Binding id}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        
        <Button 
            Margin="0 15 0 0" 
            Width="60" 
            Click="OpenAddItemModal" 
            Content="Add Item"/>
        
        <Button 
            Margin="0 100 0 0" 
            Width="60"
            Content="Issue"
            Command="{Binding Source={StaticResource ViewModel}, Path=IssueNote}"/>
    </StackPanel>
</Window>
