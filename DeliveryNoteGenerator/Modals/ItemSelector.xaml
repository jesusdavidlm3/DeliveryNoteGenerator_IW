<Window x:Class="DeliveryNoteGenerator.modals.ItemSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:DeliveryNoteGenerator.modals"
        xmlns:viewmodels="clr-namespace:DeliveryNoteGenerator.ViewModels"
        mc:Ignorable="d"
        Title="ItemSelector" Height="250" Width="400">
    
    <Window.Resources>
        <viewmodels:ItemSelectorViewModel x:Key="ViewModel"/>    
    </Window.Resources>
    
    <StackPanel HorizontalAlignment="Center" >
        <TextBlock
            Text="Select Item"
            FontSize="25"
            Margin="0 0 0 10"/>
        <Label Margin="0">Item:</Label>
        <ComboBox
            Padding="3"
            Margin="0 0 0 5"
            IsEditable="True"
            x:Name="ItemSelecto"
            IsTextSearchEnabled="False"
            StaysOpenOnEdit="True"
            DisplayMemberPath="name"
            ItemsSource="{Binding Source={StaticResource ViewModel}, Path=FilteredAssetsList, Mode=TwoWay}"
            Text="{Binding Source={StaticResource ViewModel}, Path=SearchText, Mode=TwoWay}"
            SelectedItem="{Binding Source={StaticResource ViewModel}, Path=SelectedAset, Mode=TwoWay}"/>
        <Label Content="Quantity:"/>
        <TextBox
            Text="{Binding Source={StaticResource ViewModel}, Path=Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            />
        <Button
            Content="Add"
            Width="50"
            Margin="0 25 0 0"
            Command="{Binding Source={StaticResource ViewModel}, Path=AddItemToList}"/>
    </StackPanel>
</Window>
